# --- Core ---------------------------------------------------------------
# Postgres in production. Leave unset in development to use an embedded
# Postgres (PGlite) stored under ./data/pglite.
DATABASE_URL=
# Long random string; signs the login cookie.
APP_SECRET=change-me
# Password for the single team login (phase 1 has one team).
APP_PASSWORD=change-me
# Public URL of this server; Twilio signs webhooks against it.
PUBLIC_URL=http://localhost:3000
PORT=3000
# How AI employees introduce the team ("Ava with Sunrise Home Buyers").
TEAM_NAME=
# Team's local time zone, used for quiet hours.
TEAM_TIMEZONE=America/New_York

# --- Claude (optional: without it, drafts fall back to templates) -------
ANTHROPIC_API_KEY=

# --- Twilio -------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A2P 10DLC-registered number or Messaging Service SID (one is required).
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# true = log messages instead of sending (default true until you flip it).
TWILIO_DRY_RUN=true

# --- Email (Resend-compatible HTTP API; optional) -----------------------
EMAIL_API_KEY=
EMAIL_FROM=
# CAN-SPAM requires a physical postal address in every commercial email.
BUSINESS_POSTAL_ADDRESS=

# --- Miami-Dade data ----------------------------------------------------
# ArcGIS FeatureServer/MapServer layer URL ending in /<layerId> for code
# compliance violations. Confirm the current layer on the county's open
# data portal (gis-mdc.opendata.arcgis.com) before enabling.
MDC_CODE_VIOLATIONS_LAYER_URL=
# Daily import time (24h, team time zone).
IMPORT_DAILY_AT=06:00
