{
  "name": "folio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/main.ts\" \"vite\"",
    "dev:api": "tsx watch server/main.ts",
    "build": "vite build && esbuild server/main.ts --platform=node --bundle --format=esm --packages=external --target=node22 --outdir=dist/server",
    "start": "NODE_ENV=production node dist/server/main.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "import:mdc": "tsx server/cli/import.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@electric-sql/pglite": "^0.6.0",
    "@hono/node-server": "^2.1.11",
    "@hono/trpc-server": "^0.4.2",
    "@tanstack/react-query": "^5.108.4",
    "@trpc/client": "^11.28.5",
    "@trpc/react-query": "^11.28.5",
    "@trpc/server": "^11.28.5",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.22",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "9.3.14",
    "superjson": "^2.2.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
